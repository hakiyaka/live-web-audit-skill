{
  "$comment": "Top-level contract for findings.json in a live web audit. validate-findings.cjs interprets and checks this schema directly.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "description": "A live, captured, independently replayed boundary violation.",
        "properties": {
          "verdict": { "type": "string", "const": "confirmed" },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
            "description": "Stable identity of the root cause; identical in every verdict state."
          },
          "title": { "type": "string", "minLength": 1, "visibleContent": true },
          "description": { "type": "string", "minLength": 1, "visibleContent": true },
          "root_cause": { "type": "string", "minLength": 1, "visibleContent": true },
          "intended_behavior": { "type": "string", "minLength": 1, "visibleContent": true },
          "surface": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true,
            "description": "The affected live surface: origin plus path, or the named endpoint group."
          },
          "attack_class": { "type": "string", "minLength": 1, "visibleContent": true },
          "observations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1, "visibleContent": true },
                "artifact": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^agents/[a-z0-9][a-z0-9_-]{0,63}/artifacts/[a-z0-9][a-z0-9-]{0,63}[.]json$"
                },
                "observed_at": {
                  "type": "string",
                  "minLength": 20,
                  "pattern": "^(19|20)[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "method": { "type": "string", "pattern": "^[A-Z]{3,7}$" },
                    "url": { "type": "string", "minLength": 8, "pattern": "^(http|https)://[!-~]+$" },
                    "headers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+: [^\u0000-\u001F]*$" } },
                    "body_excerpt": { "type": "string" }
                  },
                  "required": ["method", "url"],
                  "additionalProperties": false
                },
                "response": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "minimum": 100 },
                    "headers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+: [^\u0000-\u001F]*$" } },
                    "body_excerpt": { "type": "string" }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              },
              "required": ["label", "artifact", "observed_at", "request", "response"],
              "additionalProperties": false
            }
          },
          "conditions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "authentication_level",
                    "authorization_role",
                    "user_interaction",
                    "deployed_configuration",
                    "network_routing",
                    "data_state",
                    "timing_dependency",
                    "third_party_dependency"
                  ]
                },
                "description": { "type": "string", "minLength": 1, "visibleContent": true }
              },
              "required": ["kind", "description"],
              "additionalProperties": false
            }
          },
          "reproduction": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "The identity and starting capability, e.g. anonymous visitor, or tenant A's test user."
              },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "visibleContent": true } },
              "request": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "One copy-pasteable request (curl line) that reproduces the decisive observation."
              },
              "observed_result": { "type": "string", "minLength": 1, "visibleContent": true }
            },
            "required": ["actor", "steps", "request", "observed_result"],
            "additionalProperties": false
          },
          "remediation": {
            "type": "object",
            "properties": {
              "strategy": { "type": "string", "minLength": 1, "visibleContent": true },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "location": { "type": "string", "minLength": 1, "visibleContent": true },
                    "change": { "type": "string", "minLength": 1, "visibleContent": true }
                  },
                  "required": ["location", "change"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["strategy"],
            "additionalProperties": false
          },
          "severity": {
            "type": "object",
            "properties": {
              "likelihood": {
                "type": "object",
                "properties": {
                  "score": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
                  "reason": { "type": "string", "minLength": 1, "visibleContent": true }
                },
                "required": ["score", "reason"],
                "additionalProperties": false
              },
              "impact": {
                "type": "object",
                "properties": {
                  "score": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
                  "reason": { "type": "string", "minLength": 1, "visibleContent": true }
                },
                "required": ["score", "reason"],
                "additionalProperties": false
              },
              "overall_severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] }
            },
            "required": ["likelihood", "impact", "overall_severity"],
            "additionalProperties": false
          },
          "confidence": {
            "type": "object",
            "properties": {
              "score": { "type": "string", "enum": ["low", "medium", "high"] },
              "reason": { "type": "string", "minLength": 1, "visibleContent": true }
            },
            "required": ["score", "reason"],
            "additionalProperties": false
          }
        },
        "required": [
          "verdict", "fingerprint", "title", "description", "root_cause", "intended_behavior",
          "surface", "attack_class", "observations", "conditions", "reproduction", "remediation",
          "severity", "confidence"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "description": "A captured lead whose decisive observation requires an identity, asset, or owner-only fact the run lacked.",
        "properties": {
          "verdict": { "type": "string", "const": "needs_validation" },
          "fingerprint": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$" },
          "title": { "type": "string", "minLength": 1, "visibleContent": true },
          "description": { "type": "string", "minLength": 1, "visibleContent": true },
          "claimed_root_cause": { "type": "string", "minLength": 1, "visibleContent": true },
          "surface": { "type": "string", "minLength": 1, "visibleContent": true },
          "attack_class": { "type": "string", "minLength": 1, "visibleContent": true },
          "observations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1, "visibleContent": true },
                "artifact": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^agents/[a-z0-9][a-z0-9_-]{0,63}/artifacts/[a-z0-9][a-z0-9-]{0,63}[.]json$"
                },
                "observed_at": {
                  "type": "string",
                  "minLength": 20,
                  "pattern": "^(19|20)[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "method": { "type": "string", "pattern": "^[A-Z]{3,7}$" },
                    "url": { "type": "string", "minLength": 8, "pattern": "^(http|https)://[!-~]+$" },
                    "headers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+: [^\u0000-\u001F]*$" } },
                    "body_excerpt": { "type": "string" }
                  },
                  "required": ["method", "url"],
                  "additionalProperties": false
                },
                "response": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "minimum": 100 },
                    "headers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+: [^\u0000-\u001F]*$" } },
                    "body_excerpt": { "type": "string" }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              },
              "required": ["label", "artifact", "observed_at", "request", "response"],
              "additionalProperties": false
            }
          },
          "blockers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "visibleContent": true }
          },
          "validation_plan": {
            "type": "object",
            "properties": {
              "next_probe": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "One bounded request an auditor can run next, with the identity it needs."
              },
              "owner_check": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "A configuration, identity, or platform fact only the site owner can observe."
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "verdict", "fingerprint", "title", "description", "claimed_root_cause",
          "surface", "attack_class", "observations", "blockers", "validation_plan"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "description": "A captured candidate that replay disproved.",
        "properties": {
          "verdict": { "type": "string", "const": "rejected" },
          "fingerprint": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$" },
          "title": { "type": "string", "minLength": 1, "visibleContent": true },
          "description": { "type": "string", "minLength": 1, "visibleContent": true },
          "claimed_root_cause": { "type": "string", "minLength": 1, "visibleContent": true },
          "surface": { "type": "string", "minLength": 1, "visibleContent": true },
          "attack_class": { "type": "string", "minLength": 1, "visibleContent": true },
          "observations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1, "visibleContent": true },
                "artifact": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^agents/[a-z0-9][a-z0-9_-]{0,63}/artifacts/[a-z0-9][a-z0-9-]{0,63}[.]json$"
                },
                "observed_at": {
                  "type": "string",
                  "minLength": 20,
                  "pattern": "^(19|20)[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "method": { "type": "string", "pattern": "^[A-Z]{3,7}$" },
                    "url": { "type": "string", "minLength": 8, "pattern": "^(http|https)://[!-~]+$" },
                    "headers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+: [^\u0000-\u001F]*$" } },
                    "body_excerpt": { "type": "string" }
                  },
                  "required": ["method", "url"],
                  "additionalProperties": false
                },
                "response": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "minimum": 100 },
                    "headers": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+: [^\u0000-\u001F]*$" } },
                    "body_excerpt": { "type": "string" }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              },
              "required": ["label", "artifact", "observed_at", "request", "response"],
              "additionalProperties": false
            }
          },
          "reason": { "type": "string", "minLength": 1, "visibleContent": true }
        },
        "required": [
          "verdict", "fingerprint", "title", "description", "claimed_root_cause",
          "surface", "attack_class", "observations", "reason"
        ],
        "additionalProperties": false
      }
    ]
  }
}
